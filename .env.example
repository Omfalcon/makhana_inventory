# ==========================================
# Makhana Management System - Environment Variables Template
# ==========================================

# Supabase Project Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Express API Server Port (local development)
PORT=5000

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api
